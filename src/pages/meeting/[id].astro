---
import Layout from '../../layouts/Layout.astro';
import { drizzle } from 'drizzle-orm/d1';
import { meetings, meetingAttendees, users } from '../../db/schema';
import { eq, and } from 'drizzle-orm';
import GuestAttendanceForm from '../../components/GuestAttendanceForm';
import InternalAttendanceForm from '../../components/InternalAttendanceForm';

const { id } = Astro.params;

// Get meeting details
let meetingData = null;
let userHasSignature = false;
let alreadyAttended = false;

const env = Astro.locals.runtime?.env;
const currentUser = Astro.locals.user;
const isAuthenticated = Boolean(currentUser);

if (env && env.DB && id) {
  const db = drizzle(env.DB);
  const results = await db.select().from(meetings).where(eq(meetings.id, id));
  if (results.length > 0) {
    meetingData = results[0];
  }

  if (currentUser?.id) {
    const userRow = await db
      .select({ hasSignature: users.hasSignature, signatureData: users.signatureData })
      .from(users)
      .where(eq(users.id, currentUser.id))
      .limit(1);
    userHasSignature = Boolean(userRow[0]?.hasSignature && userRow[0]?.signatureData);
  }

  if (currentUser?.msId) {
    const existing = await db
      .select({ id: meetingAttendees.id })
      .from(meetingAttendees)
      .where(and(eq(meetingAttendees.meetingId, id), eq(meetingAttendees.userId, currentUser.msId)))
      .limit(1);
    alreadyAttended = existing.length > 0;
  }
}

if (!meetingData) {
  return new Response("Meeting not found", { status: 404 });
}
---

<Layout title={`Absensi Rapat - ${meetingData.title}`}>
  <div class="min-h-screen bg-slate-100 py-12 px-4 sm:px-6 animate-fadeIn">
    <div class="max-w-md mx-auto bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-200">
      <div class="p-6 bg-gradient-to-r from-blue-700 to-blue-500 text-white text-center">
        <h1 class="text-xl font-bold mb-2 leading-snug">{meetingData.title}</h1>
        <p class="text-sm opacity-90">ISO 21001:2018 Digital Attendance</p>
      </div>

      <div class="p-6 space-y-6">
        <div class="text-sm text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100">
          <div class="flex justify-between mb-2">
            <span class="font-semibold">Tanggal:</span>
            <span>{meetingData.date} &bull; {meetingData.time}</span>
          </div>
          <div class="flex justify-between">
            <span class="font-semibold">Lokasi:</span>
            <span>{meetingData.location}</span>
          </div>
        </div>

        {isAuthenticated && currentUser ? (
          <InternalAttendanceForm
            client:load
            meetingId={meetingData.id}
            user={{
              displayName: currentUser.displayName,
              department: currentUser.department,
              jobTitle: currentUser.jobTitle,
              hasSignature: userHasSignature,
            }}
            initialAttended={alreadyAttended}
          />
        ) : (
          <div class="space-y-6">
            <div class="text-center">
              <a href="/api/auth/ms-login" class="inline-block w-full py-3 bg-[#1877f2] hover:bg-blue-600 text-white font-bold rounded-xl shadow transition text-sm">
                Log In dengan Microsoft 365 (Internal)
              </a>
              <p class="text-xs text-slate-400 mt-2">Untuk Guru & Karyawan Sinar Putih Edelweiss</p>
            </div>

            <div class="relative flex items-center py-2">
              <div class="flex-grow border-t border-slate-200"></div>
              <span class="flex-shrink-0 mx-4 text-slate-400 text-xs font-semibold uppercase">Atau</span>
              <div class="flex-grow border-t border-slate-200"></div>
            </div>

            <div>
              <h3 class="text-sm font-bold text-slate-700 mb-3 text-center">Buku Tamu Eksternal</h3>
              <GuestAttendanceForm client:load meetingId={meetingData.id} />
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
