{
  "name": "iso-digital-prototype",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "dev:lan": "astro dev --host 0.0.0.0 --port 4321",
    "clean": "node scripts/clean.js",
    "build": "npm run clean && astro build",
    "build:cloudflare": "npm run clean && astro build --config astro.config.cloudflare.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "secrets:set": "wrangler pages secret put MS_CLIENT_SECRET && wrangler pages secret put SESSION_SECRET"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^11.1.0",
    "@astrojs/node": "^8.3.4",
    "@astrojs/solid-js": "^4.4.1",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.16.18",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.10.0",
    "jsbarcode": "^3.11.6",
    "lucide-solid": "^0.475.0",
    "qrcode": "^1.5.3",
    "signature_pad": "^5.0.4",
    "solid-js": "^1.8.18",
    "tailwindcss": "^3.4.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.86.0"
  }
}
